{
// place this file inside a .vscode folder inside your threagile project
// https://code.visualstudio.com/docs/editor/userdefinedsnippets

  "threagile model base": {
    "scope": "yaml",
    "prefix": "threagile model base",
    "body": [
      "threagile_version: 1.0.0",
      "",
      "title: ${1:title}",
      "",
      "date: ${2:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}",
      "",
      "author:",
      "  name: ${3:author name}",
      "  homepage: ${homepage}",
      "",
      "",
      "management_summary_comment:",
      "",
      "business_criticality: ${business criticality}",
      "",
      "",
      "business_overview:",
      "  description: Some more demo text here and even images...",
      "  images:",
      "#    - custom-image-1.png: Some dummy image 1",
      "#    - custom-image-2.png: Some dummy image 2",
      "",
      "",
      "technical_overview:",
      "  description: Some more demo text here and even images...",
      "  images:",
      "#    - custom-image-1.png: Some dummy image 1",
      "#    - custom-image-2.png: Some dummy image 2",
      "",
      "",
      "questions: # simply use \"\" as answer to signal \"unanswered\"",
      "#  Some question without an answer?: \"\"",
      "#  Some question with an answer?: Some answer",
      "",
      "",
      "abuse_cases:",
      "  Denial-of-Service: >",
      "  As a hacker I want to disturb the functionality of the backend system in order to cause indirect",
      "  financial damage via unusable features.",
      "  CPU-Cycle Theft: >",
      "  As a hacker I want to steal CPU cycles in order to transform them into money via installed crypto currency miners.",
      "  Ransomware: >",
      "  As a hacker I want to encrypt the storage and file systems in order to demand ransom.",
      "  Identity Theft: >",
      "  As a hacker I want to steal identity data in order to reuse credentials and/or keys on other targets of the same company or outside.",
      "  PII Theft: >",
      "  As a hacker I want to steal PII (Personally Identifiable Information) data in order to blackmail the company and/or damage",
      "  their repudiation by publishing the stolen data.",
      "",
      "",
      "security_requirements:",
      "  Input Validation: Strict input validation is required to reduce the overall attack surface.",
      "  EU-GDPR: Mandatory EU-GDPR",
      "",
      "",
      "# Tags can be used for anything, it's just a tag. Also risk rules can act based on tags if you like.",
      "tags_available:",
      "",
      "",
      "data_assets:",
      "",
      "$0",
      "",
      "",
      "technical_assets:",
      "",
      "",
      "trust_boundaries:",
      "",
      "",
      "shared_runtimes:",
      "",
      "",
      "individual_risk_categories:",
      "",
      "",
      "# NOTE:",
      "# For risk tracking each risk-id needs to be defined (the string with the @ sign in it). These unique risk IDs",
      "# are visible in the PDF report (the small grey string under each risk), the Excel (column \"ID\"), as well as the JSON responses.",
      "# Some risk IDs have only one @ sign in them, while others multiple. The idea is to allow for unique but still speaking IDs.",
      "# Therefore each risk instance creates its individual ID by taking all affected elements causing the risk to be within an @-delimited part.",
      "# Using wildcards (the * sign) for parts delimited by @ signs allows to handle groups of certain risks at once. Best is to lookup the IDs",
      "# to use in the created Excel file. Alternatively a model macro \"seed-risk-tracking\" is available that helps in initially",
      "# seeding the risk tracking part here based on already identified and not yet handled risks.",
      "risk_tracking:"
    ]
  },
  "threagile data asset": {
    "prefix": "threagile data asset",
    "body": [
      "${1:DataAssetName}:",
      "  id: ${2:id}",
      "  description: $0",
      "  usage: ${3|business,devops|}",
      "  tags: ${4:none}",
      "  origin:",
      "  owner:",
      "  quantity: ${5|very-few,few,many,very-many|}",
      "  confidentiality: ${6|public,internal,restricted,confidential,strictly-confidential|}",
      "  integrity: ${7|archive,operational,important,critical,mission-critical|}",
      "  availability: ${8|archive,operational,important,critical,mission-critical|}",
      "  justification_cia_rating:${9:justification}"
    ]
  },
  "threagile technical asset": {
	"prefix": "threagile technical asset",
	"body": ["${1:TechnicalAssetName}:",
		"  id: ${2:id}",
		"  description: $0",
		"  type: ${3|external-entity,process,datastore|}",
		"  usage: ${4|business,devops|}",
		"  used_as_client_by_human: ${5|true,false|}",
		"  out_of_scope: ${6|true,false|}",
		"  justification_out_of_scope: $7",
		"  size: ${8|system,service,application,component|}",
		"  technology: ${9:technology}",
		"  tags: ${10:none}",
		"  internet: ${12|true,false|}",
		"  machine: ${13|physical,virtual,container,serverless|}",
		"  encryption: ${14|none,transparent,data-with-symmetric-shared-key,data-with-asymmetric-shared-key,data-with-enduser-individual-key|}",
		"  owner: ${15:owner}",
		"  confidentiality: ${16|public,internal,restricted,confidential,strictly-confidential|}",
		"  integrity: ${17|archive,operational,important,critical,mission-critical|}",
    "  availability: ${18|archive,operational,important,critical,mission-critical|}",
    "  justification_cia_rating: ${19:justification}",
		"  multi_tenant: ${20|true,false|}",
		"  redundant: ${21|true,false|}",
		"  custom_developed_parts: ${22:custom_developed_parts}",
		"  data_assets_processed: # sequence of IDs to reference",
		"  data_assets_stored: # sequence of IDs to reference",
		"  data_formats_accepted: ${23|json,xml,serialization,file,csv|} # sequence of formats like: json, xml, serialization",
		"  communication_links:"]
  },
  "threagile communication link": {
	  "prefix": "threagile communication link",
	  "body": ["${1:CommunicationLinkName}:",
		"  target: ${2:target_id}",
		"  description: $0",
		"  protocol: ${3:protocol}",
		"  authentication: ${4|none,credentials,session-id,token,client-certificate,two-factor|}",
		"  authorization: ${5|none,technical-user,enduser-identity-propagation|}",
		"  tags: ${6:none}",
		"  vpn: ${7|true,false|}",
		"  ip_filtered: ${8|true,false|}",
		"  readonly: ${9|true,false|}",
		"  usage: ${10|business,devops|}",
		"  data_assets_sent: # sequence of IDs to reference",
		"  data_assets_received: # sequence of IDs to reference"]
  },
  "threagile trust boundary": {
	  "prefix": "threagile trust boundary",
	  "body": ["${1:TrustBoundaryName}:",
		"  id: ${2:id}",
		"  description: $0",
		"  type: ${3|network-on-prem,network-dedicated-hoster,network-virtual-lannetwork-cloud-provider,network-cloud-security-group,network-policy-namespace-isolation,execution-environment|}",
		"  tags: $tags",
		"  technical_assets_inside: # sequence of IDs to reference",
		"  trust_boundaries_nested: # sequence of IDs to reference"
    ]
  },
  "threagile shared runtime": {
	  "prefix": "threagile shared runtime",
	  "body": ["  $SharedRuntimeName:",
		"  id: $id",
		"  description: $0",
		"  tags: $tags",
		"  technical_assets_running: # sequence of IDs to reference"
    ]
  },
  "threagile risk category": {
	  "prefix": "threagile risk category",
	  "body": ["${1:IndividualRiskCategoryName}:",
		"  id: ${2:id}",
		"  description: $0",
		"  impact:",
		"  asvs:",
		"  cheat_sheet:",
		"  action:",
		"  mitigation:",
		"  check:",
		"  function: ${3|business-side,architecture,development,operations|}",
		"  stride: ${4|spoofing,tampering,repudiation,information-disclosure,denial-of-service,elevation-of-privilege|}",
		"  detection_logic:",
		"  risk_assessment:",
		"  false_positives:",
		"  model_failure_possible_reason: ${5|true,false|}",
		"  cwe: $cwe",
		"  risks_identified:"]
  },
  "threagile risk identified":{
    "prefix": "threagile risk identified",
    "body": ["{",
    "  severity: ${1|low,medium,elevated,high,critical|}",
    "  exploitation_likelihood: ${2|unlikely,likely,very-likely,frequent}",
    "  exploitation_impact: ${3|low,medium,high,very-high|}",
    "  data_breach_probability: ${4|improbable,possible,probable|}",
    "  data_breach_technical_assets: ${5:null}",
    "  most_relevant_data_asset: ${6:null}",
    "  most_relevant_technical_asset: ${7:null}",
    "  most_relevant_communication_link: ${8:null}",
    "  most_relevant_trust_boundary: ${9:null}",
    "  most_relevant_shared_runtime: ${10:null}",
    "}"]
  },
  "threagile risk instance": {
	  "prefix": "threagile risk instance",
	  "body": ["$IndividualRiskInstanceName:",
		"  severity: $severity",
		"  exploitation_likelihood: $exploitation_likelihood",
		"  exploitation_impact: $exploitation_impact",
		"  data_breach_probability: $data_breach_probability",
		"  data_breach_technical_assets: # list of technical asset IDs which might have data breach",
		"  $0",
		"  most_relevant_data_asset: $most_relevant_data_asset",
		"  most_relevant_technical_asset: $most_relevant_technical_asset",
		"  most_relevant_trust_boundary: $most_relevant_trust_boundary",
		"  most_relevant_shared_runtime: $most_relevant_shared_runtime"]
  },
  "threagile risk tracking":{
	  "prefix": "threagile risk tracking",
	  "body": ["${1:$CLIPBOARD}: # wildcards \"*\" between the @ characters are possible",
		"  status: ${2|unchecked,in-discussion,accepted,in-progress,mitigated,false-positive|}",
		"  justification: $0",
		"  ticket:",
		"  date: ${3:$CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE}",
		"  checked_by: ${4:checked by}"]
  }
}